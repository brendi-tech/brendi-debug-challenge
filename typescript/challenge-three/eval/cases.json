[
  {
    "name": "simples",
    "messages": [{ "from": "customer", "text": "oi, quero um x-salada" }],
    "expect": { "items": [{ "productId": "x-salada", "quantity": 1 }], "totalCents": 2200 }
  },
  {
    "name": "quantidade",
    "messages": [{ "from": "customer", "text": "me vê 2 x-tudo por favor" }],
    "expect": { "items": [{ "productId": "x-tudo", "quantity": 2 }], "totalCents": 6400 }
  },
  {
    "name": "adicionais + remoção",
    "messages": [{ "from": "customer", "text": "um x-salada com bacon e ovo, mas sem cebola" }],
    "expect": { "items": [{ "productId": "x-salada", "quantity": 1 }], "totalCents": 2850 }
  },
  {
    "name": "ambiguidade (não alucinar)",
    "messages": [{ "from": "customer", "text": "queria aquele hambúrguer com bacon" }],
    "expect": { "clarification": true }
  },
  {
    "name": "incluso vs extra (marmita)",
    "messages": [{ "from": "customer", "text": "quero uma marmita com bife e frango" }],
    "expect": { "items": [{ "productId": "marmita", "quantity": 1 }], "totalCents": 3700 }
  },
  {
    "name": "mudança de ideia",
    "messages": [
      { "from": "customer", "text": "quero um x-bacon" },
      { "from": "customer", "text": "ah não, deixa um x-salada mesmo" }
    ],
    "expect": { "items": [{ "productId": "x-salada", "quantity": 1 }], "totalCents": 2200 }
  },
  {
    "name": "combo",
    "messages": [{ "from": "customer", "text": "me vê um combo x-salada" }],
    "expect": { "items": [{ "productId": "combo-x-salada", "quantity": 1 }], "totalCents": 3500 }
  }
]
